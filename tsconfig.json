{
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2018",
    "module": "commonjs",
    "lib": ["ES2018", "DOM"],
    "skipLibCheck": true,
    "allowUmdGlobalAccess": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules/*"]
}
